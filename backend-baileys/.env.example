PORT=8490
HOST=0.0.0.0

# Reuse the existing wildcard cert — no new subdomain, no nginx/aaPanel change.
SSL_CERT=/www/server/panel/vhost/cert/whatsapp.smartstick-iq.com/fullchain.pem
SSL_KEY=/www/server/panel/vhost/cert/whatsapp.smartstick-iq.com/privkey.pem

# Same MySQL as the Chrome backend so users/accounts/billing stay shared
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=whatsapp_api

JWT_SECRET=change-me

# Baileys auth files (NOT the Chrome LocalAuth folder)
SESSION_PATH=/var/lib/whatsapp-api/.baileys_auth

AUTO_LOAD_ACCOUNTS=false
MAX_AUTO_LOAD_ACCOUNTS=8
WA_MAX_LIVE_SESSIONS=20
WA_MAX_CONCURRENT_STARTS=3
WA_RAM_BLOCK_PERCENT=90
WA_QR_TIMEOUT_MS=120000
WA_IDLE_UNLOAD_MS=900000
WA_SESSION_KEEPALIVE_MS=0

FRONTEND_URL=https://whatsapp.smartstick-iq.com
API_PUBLIC_URL=http://74.50.65.142:8490
