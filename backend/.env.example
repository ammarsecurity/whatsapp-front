PORT=8489

# MySQL
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=whatsapp_api

# JWT
JWT_SECRET=change-me

# Ubuntu — your server path (verified: /usr/bin/google-chrome)
CHROME_PATH=/usr/bin/google-chrome

# WhatsApp session files (use absolute path on production)
SESSION_PATH=/var/lib/whatsapp-api/.wwebjs_auth

# Chrome writable HOME (fixes /root/.local/share permission errors on Ubuntu)
CHROME_HOME=/var/lib/whatsapp-api/chrome-home

# Optional: extra Chrome flags (comma-separated)
# CHROME_EXTRA_ARGS=--window-size=1280,720

# Puppeteer timeouts (ms)
PUPPETEER_TIMEOUT_MS=120000
PUPPETEER_PROTOCOL_TIMEOUT_MS=120000

# Admin users (Super Admin page) — comma-separated IDs or usernames
ADMIN_USER_IDS=1
ADMIN_USERNAMES=admin

# Session restore after server restart (saved Chrome profiles on disk)
# false = only restore folders that already exist (recommended — lighter than full auto-load)
AUTO_LOAD_ACCOUNTS=false
# How many saved sessions to restore at startup when AUTO_LOAD_ACCOUNTS=false
# 0 = restore ALL linked accounts (recommended for production)
MAX_AUTO_LOAD_ACCOUNTS=0

# Optional: ping ready sessions every N ms to detect drops early (0 = off, default 120000)
# WA_SESSION_KEEPALIVE_MS=120000

# Public URLs (payment redirects + webhook hints in admin UI)
# FRONTEND_URL must match the domain registered with FynexPay (redirect + callback URLs).
FRONTEND_URL=https://whatsapp.smartstick-iq.com
# API subdomain — used for Wayl webhooks and general API links (not FynexPay callback).
API_PUBLIC_URL=https://whatsapp-api.smartstick-iq.com

# AES key for storing Wayl / FynexPay secrets (32+ characters)
PAYMENT_ENCRYPTION_KEY=change-me-to-a-long-random-string

# Optional if you later price plans in USD
# USD_TO_IQD_RATE=1500

